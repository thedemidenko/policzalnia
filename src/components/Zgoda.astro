---
// Baner zgody na cookies + Google Analytics (tag Google GTM-P8JC9WHH) w trybie Consent Mode v2.
// Tag Google ładuje się dopiero po kliknięciu „Akceptuję” (zgodnie z polityką prywatności).
// Wybór zapisujemy w localStorage pod kluczem 'zgoda-cookies' ('tak' / 'nie').
// Link z atrybutem data-zgoda (np. w stopce) ponownie otwiera baner.
const TAG = 'GTM-P8JC9WHH';
---
<div class="zgoda" id="zgoda" role="dialog" aria-live="polite" aria-label="Zgoda na pliki cookie" hidden>
  <p>
    Chcemy używać Google Analytics (pliki cookie), żeby sprawdzać, które kalkulatory są przydatne. Włączymy je tylko za Twoją zgodą.
    <a href="/polityka-prywatnosci/">Polityka prywatności</a>
  </p>
  <div class="zgoda-przyciski">
    <button type="button" class="zgoda-nie" data-wybor="nie">Odrzucam</button>
    <button type="button" class="zgoda-tak" data-wybor="tak">Akceptuję</button>
  </div>
</div>
<script is:inline define:vars={{ TAG }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  window.gtag = gtag;
  gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied' });

  var KLUCZ = 'zgoda-cookies';
  var zaladowany = false;
  function czytaj() { try { return localStorage.getItem(KLUCZ); } catch (e) { return null; } }
  function zapisz(v) { try { localStorage.setItem(KLUCZ, v); } catch (e) {} }
  function zaladujTag() {
    if (zaladowany) return;
    zaladowany = true;
    gtag('consent', 'update', { analytics_storage: 'granted' });
    gtag('js', new Date());
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtm.js?id=' + TAG;
    document.head.appendChild(s);
  }
  function usunCiasteczkaGa() {
    document.cookie.split(';').forEach(function (c) {
      var n = c.split('=')[0].trim();
      if (/^_ga/.test(n)) {
        var d = location.hostname.replace(/^www\./, '');
        document.cookie = n + '=; Max-Age=0; path=/; domain=.' + d;
        document.cookie = n + '=; Max-Age=0; path=/';
      }
    });
  }

  var baner = document.getElementById('zgoda');
  function pokaz() { baner.hidden = false; }
  baner.addEventListener('click', function (e) {
    var w = e.target.closest('[data-wybor]');
    if (!w) return;
    var wybor = w.getAttribute('data-wybor');
    var poprzedni = czytaj();
    zapisz(wybor);
    baner.hidden = true;
    if (wybor === 'tak') zaladujTag();
    else if (poprzedni === 'tak') { usunCiasteczkaGa(); location.reload(); }
  });
  document.addEventListener('click', function (e) {
    var l = e.target.closest('[data-zgoda]');
    if (!l) return;
    e.preventDefault();
    pokaz();
  });

  var stan = czytaj();
  if (stan === 'tak') zaladujTag();
  else if (stan !== 'nie') pokaz();
</script>
<style>
  .zgoda {
    position: fixed; z-index: 50; left: 1rem; right: 1rem; bottom: 1rem;
    max-width: 40rem; margin: 0 auto; padding: 1rem 1.1rem;
    background: var(--kartka); color: var(--tusz);
    border: 1px solid var(--linia); border-radius: var(--r); box-shadow: var(--cien);
    display: flex; flex-wrap: wrap; gap: .75rem 1rem; align-items: center;
    font-size: .95rem; line-height: 1.45;
  }
  .zgoda[hidden] { display: none; }
  .zgoda p { margin: 0; flex: 1 1 18rem; }
  .zgoda a { color: var(--dlugopis); }
  .zgoda-przyciski { display: flex; gap: .5rem; flex-wrap: wrap; }
  .zgoda button {
    font: inherit; font-weight: 600; cursor: pointer;
    padding: .55rem 1rem; border-radius: 999px; border: 1.5px solid var(--dlugopis);
  }
  .zgoda-nie { background: transparent; color: var(--dlugopis); }
  .zgoda-tak { background: var(--dlugopis); color: var(--na-dlugopisie); }
  .zgoda button:hover { filter: brightness(1.08); }
</style>
