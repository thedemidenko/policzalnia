---
import type { KluczKalkulatora } from '../lib/rejestr';
import Vat from './kalkulatory/Vat.astro';
import Odsetki from './kalkulatory/Odsetki.astro';
import OdsetkiPodatkowe from './kalkulatory/OdsetkiPodatkowe.astro';
import Staz from './kalkulatory/Staz.astro';
import Urlop from './kalkulatory/Urlop.astro';
import Delegacja from './kalkulatory/Delegacja.astro';
import Macierzynski from './kalkulatory/Macierzynski.astro';
import Ekwiwalent from './kalkulatory/Ekwiwalent.astro';
import L4 from './kalkulatory/L4.astro';
import DniRobocze from './kalkulatory/DniRobocze.astro';
import Nadgodziny from './kalkulatory/Nadgodziny.astro';
import Dzielo from './kalkulatory/Dzielo.astro';
import Zlecenie from './kalkulatory/Zlecenie.astro';
import Leasing from './kalkulatory/Leasing.astro';
import Lokaty from './kalkulatory/Lokaty.astro';
import Nadplata from './kalkulatory/Nadplata.astro';
import Ppk from './kalkulatory/Ppk.astro';
import ProcentSkladany from './kalkulatory/ProcentSkladany.astro';
import Obligacje from './kalkulatory/Obligacje.astro';
import Ike from './kalkulatory/Ike.astro';
import Inflacja from './kalkulatory/Inflacja.astro';
import Inwestycje from './kalkulatory/Inwestycje.astro';
import Ikze from './kalkulatory/Ikze.astro';
import UmowyTerminowe from './kalkulatory/UmowyTerminowe.astro';
import OdsetkiZus from './kalkulatory/OdsetkiZus.astro';
import DietaZagraniczna from './kalkulatory/DietaZagraniczna.astro';

const KOMPONENTY = {
  vat: Vat,
  odsetki: Odsetki,
  'odsetki-podatkowe': OdsetkiPodatkowe,
  staz: Staz,
  urlop: Urlop,
  delegacja: Delegacja,
  macierzynski: Macierzynski,
  ekwiwalent: Ekwiwalent,
  l4: L4,
  'dni-robocze': DniRobocze,
  nadgodziny: Nadgodziny,
  dzielo: Dzielo,
  zlecenie: Zlecenie,
  leasing: Leasing,
  lokaty: Lokaty,
  nadplata: Nadplata,
  ppk: Ppk,
  'procent-skladany': ProcentSkladany,
  obligacje: Obligacje,
  ike: Ike,
  inflacja: Inflacja,
  inwestycje: Inwestycje,
  ikze: Ikze,
  'umowy-terminowe': UmowyTerminowe, 'odsetki-zus': OdsetkiZus, 'dieta-zagraniczna': DietaZagraniczna,
} satisfies Record<KluczKalkulatora, unknown>;

interface Props { klucz: KluczKalkulatora }
const K = KOMPONENTY[Astro.props.klucz];
---
<section class="kalkulator" id="kalkulator" aria-label="Kalkulator">
  <K />
  <div class="akcje">
    <button type="button" class="przycisk glowny" data-udostepnij>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1"/><path d="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"/></svg>
      Link do wyliczenia
    </button>
    <button type="button" class="przycisk" data-kopiuj>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h8"/></svg>
      Kopiuj wynik
    </button>
    <button type="button" class="przycisk" data-drukuj>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 9V3h12v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M6 14h12v7H6z"/></svg>
      Drukuj / PDF
    </button>
    <span class="komunikat" data-komunikat role="status"></span>
  </div>
</section>
<a class="pasek-wyniku" href="#kalkulator" data-pasek aria-hidden="true" tabindex="-1">
  <span data-pasek-etykieta>Wynik</span><strong data-pasek-wartosc></strong>
</a>
<script>
  const kalk = document.getElementById('kalkulator');
  const pasek = document.querySelector<HTMLElement>('[data-pasek]');
  const glowny = kalk?.querySelector<HTMLElement>('[data-glowny]');
  if (kalk && pasek && glowny) {
    const et = pasek.querySelector('[data-pasek-etykieta]')!;
    const wa = pasek.querySelector('[data-pasek-wartosc]')!;
    const kopiuj = () => { et.textContent = glowny.dataset.glowny || 'Wynik'; wa.textContent = glowny.dataset.wartosc || glowny.textContent; };
    new MutationObserver(kopiuj).observe(glowny, { attributes: true, childList: true, characterData: true, subtree: true });
    kopiuj();
    // pokaż pasek, gdy użytkownik przewinął poniżej kalkulatora
    new IntersectionObserver(([e]) => {
      pasek.classList.toggle('widoczny', !e.isIntersecting && e.boundingClientRect.top < 0);
    }).observe(kalk);
  }
</script>
