---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import site from '../site.json';
const dzialy = (await getCollection('dzialy')).sort((a, b) => a.data.kolejnosc - b.data.kolejnosc);
const kalk = await getCollection('kalkulatory', (e) => !e.data.draft);
const schema = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: 'https://policzalnia.pl/', inLanguage: 'pl-PL' };
---
<Base title={`${site.name} - ${site.tagline.toLowerCase()}`} description="Kalkulatory wynagrodzeń, umów, urlopów, podatków, kredytów i oszczędności. Aktualne stawki, wynik od razu." schema={schema}>
  <h1>{site.tagline}</h1>
  <p class="lead">Wynagrodzenia, umowy, urlopy, podatki JDG, kredyty i oszczędności. Aktualne stawki i wynik od razu.</p>
  {dzialy.map((d) => {
    const lista = kalk.filter((e) => e.data.sekcja === d.data.slug);
    return (
      <section>
        <h2><a href={`/${d.data.slug}/`}>{d.data.title}</a></h2>
        {lista.length > 0
          ? <ul class="lista">{lista.map((e) => <li><a href={`/${e.data.sekcja}/${e.data.slug}/`}>{e.data.nazwa_krotka ?? e.data.title}</a></li>)}</ul>
          : <p>{d.data.lead}</p>}
      </section>
    );
  })}
</Base>
