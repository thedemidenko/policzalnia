---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Vat from '../components/kalkulatory/Vat.astro';
import Marza from '../components/kalkulatory/Marza.astro';

export async function getStaticPaths() {
  const items = await getCollection('kalkulatory', (e) => !e.data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const komponenty = { vat: Vat, marza: Marza };
const Kalkulator = komponenty[entry.data.kalkulator];
const d = entry.data;
const schema = d.faq.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.pytanie, acceptedAnswer: { '@type': 'Answer', text: f.odpowiedz } })),
} : undefined;
---
<Base title={d.meta_title} description={d.meta_description} schema={schema}>
  <h1>{d.title}</h1>
  {d.lead && <p>{d.lead}</p>}
  <Kalkulator />
  <Content />
  {d.faq.length > 0 && (
    <section>
      <h2>Najczęściej zadawane pytania</h2>
      {d.faq.map((f) => (<><h3>{f.pytanie}</h3><p>{f.odpowiedz}</p></>))}
    </section>
  )}
  {d.updated && <p><small>Aktualizacja: {d.updated.toLocaleDateString('pl-PL')}</small></p>}
</Base>
