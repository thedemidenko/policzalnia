---
import { getCollection } from 'astro:content';
import site from '../site.json';
import Reklama from '../components/Reklama.astro';
import Logo from '../components/Logo.astro';
import Zgoda from '../components/Zgoda.astro';
import '../styles/global.css';

interface Props { title: string; description: string; schema?: object; sidebar?: boolean; obraz?: string; artykul?: { opublikowano: string; zmieniono: string }; noindex?: boolean }
const { title, description, schema, sidebar = false, obraz, artykul, noindex = false } = Astro.props;
const ogObraz = new URL(obraz ?? '/og.png', Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const dzialy = (await getCollection('dzialy')).sort((a, b) => a.data.kolejnosc - b.data.kolejnosc);
const strony = (await getCollection('strony')).filter((s) => s.data.stopka);
const sekcja = Astro.url.pathname.split('/')[1];
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f4ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15201c" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(site.noindex || noindex) && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={artykul ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:image" content={ogObraz} />
    {!obraz && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    {artykul && <><meta property="article:published_time" content={artykul.opublikowano} /><meta property="article:modified_time" content={artykul.zmieniono} /></>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <header class="top">
      <div class="wrap top-in">
        <Logo />
        <nav class="menu" aria-label="Działy">
          {dzialy.map((d) => <a href={`/${d.data.slug}/`} aria-current={sekcja === d.data.slug ? 'true' : undefined}>{d.data.title}</a>)}
          <a href="/poradniki/" aria-current={sekcja === 'poradniki' ? 'true' : undefined}>Poradniki</a>
        </nav>
      </div>
    </header>
    <div class:list={['wrap', 'uklad', { 'z-sidebarem': sidebar }]}>
      <main class:list={[{ kolumna: sidebar }]}><slot /></main>
      {sidebar && <aside class="sidebar"><div class="sticky"><Reklama slot="sidebar" /><slot name="sidebar" /></div></aside>}
    </div>
    <footer>
      <div class="wrap">
        <Logo />
        <nav aria-label="Działy">{dzialy.map((d) => <a href={`/${d.data.slug}/`}>{d.data.title}</a>)}<a href="/poradniki/">Poradniki</a></nav>
        <nav aria-label="Informacje">{strony.map((s) => <a href={`/${s.data.slug}/`}>{s.data.title}</a>)}<a href="#" data-zgoda>Ustawienia cookies</a></nav>
        <p>© {new Date().getFullYear()} {site.name}. Wyniki kalkulatorów mają charakter informacyjny i nie stanowią porady podatkowej.</p>
      </div>
    </footer>
    <Zgoda />
    <script>
      // menu działów na telefonie: zanikanie przy krawędziach, aktywny dział widoczny bez przewijania
      const menu = document.querySelector<HTMLElement>('.menu');
      if (menu) {
        const akt = menu.querySelector<HTMLElement>('[aria-current]');
        if (akt && menu.scrollWidth > menu.clientWidth) menu.scrollLeft = akt.offsetLeft - (menu.clientWidth - akt.offsetWidth) / 2;
        const stan = () => {
          menu.classList.toggle('na-poczatku', menu.scrollLeft <= 4);
          menu.classList.toggle('na-koncu', menu.scrollLeft + menu.clientWidth >= menu.scrollWidth - 4);
        };
        menu.addEventListener('scroll', stan, { passive: true });
        addEventListener('resize', stan);
        stan();
      }
    </script>
  </body>
</html>
