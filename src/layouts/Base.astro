---
import { getCollection } from 'astro:content';
import site from '../site.json';
import Reklama from '../components/Reklama.astro';
import '../styles/global.css';

interface Props { title: string; description: string; schema?: object; sidebar?: boolean }
const { title, description, schema, sidebar = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const dzialy = (await getCollection('dzialy')).sort((a, b) => a.data.kolejnosc - b.data.kolejnosc);
const strony = (await getCollection('strony')).filter((s) => s.data.stopka);
const sekcja = Astro.url.pathname.split('/')[1];
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {site.noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pl_PL" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <header class="top">
      <div class="wrap top-in">
        <a class="logo" href="/">{site.name}</a>
        <nav aria-label="Działy">
          {dzialy.map((d) => <a href={`/${d.data.slug}/`} aria-current={sekcja === d.data.slug ? 'true' : undefined}>{d.data.title}</a>)}
          <a href="/poradniki/" aria-current={sekcja === 'poradniki' ? 'true' : undefined}>Poradniki</a>
        </nav>
      </div>
    </header>
    <div class:list={['wrap', { 'z-sidebarem': sidebar }]}>
      <main><slot /></main>
      {sidebar && <aside class="sidebar"><div class="sticky"><Reklama slot="sidebar" /><slot name="sidebar" /></div></aside>}
    </div>
    <footer>
      <div class="wrap">
        <nav aria-label="Informacje">{strony.map((s) => <a href={`/${s.data.slug}/`}>{s.data.title}</a>)}</nav>
        <p>© {new Date().getFullYear()} {site.name}. Wyniki kalkulatorów mają charakter informacyjny i nie stanowią porady podatkowej.</p>
      </div>
    </footer>
  </body>
</html>
